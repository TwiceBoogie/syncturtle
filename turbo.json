{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".yarnrc.yml",
    "package.json",
    "yarn.lock",
    "vitest.shared.ts",
    "packages/typescript-config/*.json",
    "packages/tailwind-config/*.css"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.ts", "!**/*.stories.tsx", "!**/*.stories.mdx", "!.storybook/**"],
      "env": ["SYNCTURTLE_VERSION", "NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**", "target/**", "**/target/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.stories.@(ts|tsx|mdx)", ".storybook/**"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": []
    },
    "test:it": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:system": {
      "dependsOn": ["build"],
      "cache": false
    },
    "verify": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
