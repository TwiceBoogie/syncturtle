{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "SYNCTURTLE_VERSION",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_WEB_BASE_URL",
    "NEXT_PUBLIC_ADMIN_BASE_URL",
    "NEXT_PUBLIC_ADMIN_BASE_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "**/target/**", "out/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
