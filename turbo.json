{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "SYNCTURTLE_VERSION",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_WEB_BASE_URL",
    "NEXT_PUBLIC_ADMIN_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "**/target/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "check": {
      "dependsOn": ["check:link", "check:types"],
      "cache": false
    },
    "check:types": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
