{
  "extends": "@syncturtle/typescript-config/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["core/*"],
      "@/app/*": ["app/*"],
      "@/public/*": ["public/*"],
      "@/styles/*": ["styles/*"],
      "@/syncturtle-admin/*": ["ce/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
