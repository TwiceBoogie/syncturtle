ARG JAVA_VERSION=21
ARG MODULE_PATH

# 1: BUILD STAGE
FROM maven:3.9.9-eclipse-temurin-${JAVA_VERSION} AS build

ARG MODULE_PATH
WORKDIR /workspace

# 1.1: copy maven wrapper + root pom first for caching
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

# 1.2: copy module poms (cache-friendly)
COPY libs/common-core/pom.xml libs/common-core/pom.xml
COPY libs/common-data-jpa/pom.xml libs/common-data-jpa/pom.xml
COPY libs/common-spring/pom.xml libs/common-spring/pom.xml
COPY libs/common-web/pom.xml libs/common-web/pom.xml
COPY libs/test-support/pom.xml libs/test-support/pom.xml

COPY platform/api-gateway/pom.xml platform/api-gateway/pom.xml
COPY platform/config-server/pom.xml platform/config-server/pom.xml
COPY platform/discovery-server/pom.xml platform/discovery-server/pom.xml

COPY services/instance-service/pom.xml services/instance-service/pom.xml
COPY services/user-service/pom.xml services/user-service/pom.xml

COPY tests/system-tests/pom.xml tests/system-tests/pom.xml

# 1.3: warm dependency cache
RUN ./mvnw -pl ${MODULE_PATH} -am -DskipTests dependency:go-offline

# 1.4: copy source
COPY libs/ libs/
COPY platform/ platform/
COPY services/ services/

# 1.5: build the jar
RUN ./mvnw -pl ${MODULE_PATH} -am -DskipTests package

# 1.6: extract layered jar
RUN JAR_FILE=$(ls ${MODULE_PATH}/target/*.jar | head -n 1) && \
    mkdir -p /layers && \
    cp "$JAR_FILE" /layers/app.jar && \
    java -Djarmode=layertools -jar /layers/app.jar extract --destination /layers/extracted

# 2: RUNTIME STAGE
FROM eclipse-temurin:${JAVA_VERSION}-jre

WORKDIR /app

# 2.1: run as non-root user
RUN useradd -r -u 10001 -g root syncturtle
USER syncturtle

# 2.2: copy extracted layers
COPY --from=build /layers/extracted/dependencies/ ./
COPY --from=build /layers/extracted/snapshot-dependencies/ ./
COPY --from=build /layers/extracted/spring-boot-loader/ ./
COPY --from=build /layers/extracted/application/ ./

EXPOSE 8000 8001 8002 8761 8888 8080

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC"
ENTRYPOINT [ "sh", "-c", "java $JAVA_OPTS org.springframework.boot.loader.launch.JarLauncher" ]