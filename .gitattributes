# Normalize all text to LF in repo
* text=auto eol=lf

# Windows scripts can stay CRLF if you have them
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts should always be LF
*.sh text eol=lf

# Treat common binary assets as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
