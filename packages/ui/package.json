{
  "name": "@syncturtle/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build": "tsup",
    "build:storybook": "storybook build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .turbo dist storybook-static"
  },
  "peerDependencies": {
    "@heroui/react": "^3.2.1",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@heroui/react": "catalog:heroui3",
    "@heroui/styles": "catalog:heroui3",
    "@storybook/addon-docs": "catalog:storybook10",
    "@storybook/react-vite": "catalog:storybook10",
    "@syncturtle/eslint-config": "workspace:*",
    "@syncturtle/tailwind-config": "workspace:*",
    "@syncturtle/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "storybook": "catalog:storybook10",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
