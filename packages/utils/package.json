{
  "name": "@syncturtle/utils",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .turbo dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@syncturtle/constants": "workspace:*",
    "@syncturtle/types": "workspace:*"
  },
  "devDependencies": {
    "@syncturtle/eslint-config": "workspace:*",
    "@syncturtle/typescript-config": "workspace:*",
    "@types/node": "catalog:next16",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
