{
  "name": "@syncturtle/tailwind-config",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "styles.css",
    "theme.css"
  ],
  "exports": {
    ".": {
      "style": "./styles.css",
      "default": "./styles.css"
    },
    "./styles": {
      "style": "./styles.css",
      "default": "./styles.css"
    },
    "./theme": {
      "style": "./styles.css",
      "default": "./styles.css"
    }
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  }
}
