# Mode C: infrastructure in Compose; applications run directly on host ports.

SPRING_PROFILES_ACTIVE=local
CONFIG_SERVER_BACKEND_PROFILE=native
SPRING_CONFIG_IMPORT=configserver:http://localhost:8888
CONFIG_SERVER_URL=http://localhost:8888
DEPLOYMENT_ENV=host-direct-local
SYNCTURTLE_DEPLOYMENT_ID=host-direct-local
SYNCTURTLE_REPLICA_ID=single
SYNCTURTLE_SERVICE_REPLICA_COUNT=1
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
APP_KAFKA_TOPIC_PARTITIONS=3
APP_KAFKA_TOPIC_REPLICAS=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__

INSTANCE_DB_PASSWORD=__GENERATE_INSTANCE_DB_PASSWORD__
INSTANCE_MIGRATOR_DB_PASSWORD=__GENERATE_INSTANCE_MIGRATOR_DB_PASSWORD__
USER_DB_PASSWORD=__GENERATE_USER_DB_PASSWORD__
USER_MIGRATOR_DB_PASSWORD=__GENERATE_USER_MIGRATOR_DB_PASSWORD__
WORKSPACE_DB_PASSWORD=__GENERATE_WORKSPACE_DB_PASSWORD__
WORKSPACE_MIGRATOR_DB_PASSWORD=__GENERATE_WORKSPACE_MIGRATOR_DB_PASSWORD__
FILE_DB_PASSWORD=__GENERATE_FILE_DB_PASSWORD__
FILE_MIGRATOR_DB_PASSWORD=__GENERATE_FILE_MIGRATOR_DB_PASSWORD__
EMAIL_DB_PASSWORD=__GENERATE_EMAIL_DB_PASSWORD__
EMAIL_MIGRATOR_DB_PASSWORD=__GENERATE_EMAIL_MIGRATOR_DB_PASSWORD__

APP_SECURITY_ENCRYPTION_SECRET_KEY=__GENERATE_APP_SECURITY_ENCRYPTION_SECRET_KEY__
APP_SECURITY_CSRF_SIGNING_KEY=__GENERATE_APP_SECURITY_CSRF_SIGNING_KEY__
APP_SECURITY_CSRF_ENABLED=true
APP_SECURITY_COOKIES_SECURE=false
APP_SECURITY_COOKIES_MANAGED_PREFIX_ENABLED=false
APP_PUBLIC_API_ORIGIN=http://localhost:8000
APP_PUBLIC_API_BASE_PATH=/
APP_PUBLIC_WEB_ORIGIN=http://localhost:3000
APP_PUBLIC_WEB_BASE_PATH=/
APP_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
APP_PUBLIC_ADMIN_BASE_PATH=/god-mode/
APP_PASSPORT_ISSUER=http://localhost:8000/auth
APP_PASSPORT_AUDIENCE=syncturtle-api-local
APP_PASSPORT_KID=__GENERATE_APP_PASSPORT_KID__
APP_PASSPORT_PRIVATE_KEY_LOCATION=__GENERATE_APP_PASSPORT_PRIVATE_KEY_LOCATION__
APP_PASSPORT_PUBLIC_KEY_LOCATION=__GENERATE_APP_PASSPORT_PUBLIC_KEY_LOCATION__
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
GATEWAY_TRUSTED_PROXY_COUNT=0

APP_STORAGE_ACCESS_KEY=syncturtle-local
APP_STORAGE_SECRET_KEY=__GENERATE_APP_STORAGE_SECRET_KEY__
APP_STORAGE_REGION=us-east-1
APP_STORAGE_BUCKET=syncturtle
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
APP_STORAGE_USE_PATH_STYLE=true
APP_STORAGE_PRESIGN_EXPIRATION=10m

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_PATH=
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WEB_BASE_PATH=
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_BASE_PATH=/god-mode

APP_NAME=syncturtle
APP_EDITION=COMMUNITY
APP_TEST=false
APP_SKIP_ENV_VAR=true
APP_TELEMETRY_ENABLED=true
APP_TELEMETRY_SUPPORT_REQUIRED=false
APP_ENABLE_SIGNUP=1
APP_ENABLE_EMAIL_PASSWORD=1
APP_DISABLE_WORKSPACE_CREATION=0
APP_ENABLE_SMTP=0
APP_ENABLE_MAGIC_LINK_LOGIN=0
PRODUCT_TELEMETRY_ENABLED=false
PRODUCT_TELEMETRY_ENDPOINT=http://localhost:15317

APP_WEB_ACCESS_LOGGING_ENABLED=true
APP_REDIS_KEY_PREFIX=st:host-direct-local:
APP_RESPONSE_CACHE_ENABLED=true
APP_RESPONSE_CACHE_KEY_PREFIX=st:host-direct-local:rc:
APP_RESPONSE_CACHE_HASH_BYTES=16
OPENTELEMETRY_ENABLED=true
TRACING_SAMPLING_PROBABILITY=1.0
OTLP_TRACES_ENABLED=true
OTLP_TRACES_ENDPOINT=http://localhost:14317
OTLP_METRICS_ENABLED=true
OTLP_METRICS_URL=http://localhost:14318/v1/metrics
OTLP_LOGS_ENABLED=true
OTLP_LOGS_ENDPOINT=http://localhost:14317
LOG_EXPORT_ENABLED=true
