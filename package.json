{
  "name": "syncturtle",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=18",
    "start": "turbo run start",
    "clean": "turbo run clean && rm -rf .turbo **/.next **/dist **/node_modules",
    "check": "turbo run check",
    "sync:versions": "node scripts/sync-versions.mjs",
    "check:versions": "node scripts/sync-versions.mjs && git diff --exit-code"
  },
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "turbo": "^2.6.3"
  }
}
