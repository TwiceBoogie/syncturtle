{
  "name": "syncturtle",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=18",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck --continue",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "yarn format:check && turbo run lint typecheck test --continue",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf node_modules",
    "sync:versions": "node scripts/sync-versions.mjs",
    "check:versions": "node scripts/sync-versions.mjs && git diff --exit-code"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-prettier": "10.1.8",
    "lefthook": "^2.0.15",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "^2.7.5"
  }
}
