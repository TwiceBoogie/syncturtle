{
  "name": "syncturtle",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=18",
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook",
    "start": "turbo run start",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test --continue",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "constraints": "yarn constraints",
    "constraints:fix": "yarn constraints --fix",
    "dedupe:check": "yarn dedupe --check",
    "check": "yarn constraints && yarn dedupe --check && yarn format:check && turbo run lint typecheck test --continue",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "sync:versions": "node scripts/sync-versions.mjs",
    "check:versions": "node scripts/sync-versions.mjs && git diff --exit-code"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "packageManager": "yarn@4.13.0",
  "devDependencies": {
    "@yarnpkg/types": "^4.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "lefthook": "^2.1.4",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "^2.9.1"
  }
}
