# Local development can load one shared file. Container deployments should
# supply only the variables required by each individual container.

# Shared local infrastructure
SPRING_PROFILES_ACTIVE=local
DEPLOYMENT_ENV=local
CONFIG_SERVER_URL=http://localhost:8888

# Instance-configuration invalidation identity.
SYNCTURTLE_DEPLOYMENT_ID=local
SYNCTURTLE_REPLICA_ID=single
SYNCTURTLE_SERVICE_REPLICA_COUNT=1

# config-server (git profile only)
CONFIG_GIT_URI=
CONFIG_GIT_LABEL=main
CONFIG_GIT_PATHS=config

# discovery-server but we don't use anymore
EUREKA_HOST=localhost

# API Gateway and shared public URLs
APP_PASSPORT_ISSUER=http://localhost:8000/auth
APP_PASSPORT_AUDIENCE=syncturtle-api-local
APP_PASSPORT_KID=local-dev-key
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_TRUSTED_PROXY_COUNT=0
REDIS_HOST=localhost
REDIS_PORT=6379

# Shared application behavior
APP_PUBLIC_API_ORIGIN=http://localhost:8000
APP_PUBLIC_API_BASE_PATH=/
APP_PUBLIC_WEB_ORIGIN=http://localhost:3000
APP_PUBLIC_WEB_BASE_PATH=/
APP_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
APP_PUBLIC_ADMIN_BASE_PATH=/god-mode/
APP_WEB_ACCESS_LOGGING_ENABLED=true
APP_REDIS_KEY_PREFIX=st:local:
APP_RESPONSE_CACHE_ENABLED=true
APP_RESPONSE_CACHE_KEY_PREFIX=st:local:rc:
APP_RESPONSE_CACHE_HASH_BYTES=16

# Shared security. Replace these development only examples before deployment.
APP_SECURITY_ENCRYPTION_SECRET_KEY=local-dev-encryption-key-not-for-production
APP_SECURITY_CSRF_SIGNING_KEY=local-dev-csrf-signing-key-not-for-production
APP_SECURITY_CSRF_ENABLED=true
APP_SECURITY_COOKIES_SECURE=false
APP_SECURITY_COOKIES_HOST_PREFIX_ENABLED=false
APP_SECURITY_COOKIES_DOMAIN=

# Shared observability
OPENTELEMETRY_ENABLED=true
TRACING_SAMPLING_PROBABILITY=1.0
OTLP_TRACES_ENABLED=true
OTLP_TRACES_ENDPOINT=http://localhost:14317
OTLP_METRICS_ENABLED=true
OTLP_METRICS_URL=http://localhost:14318/v1/metrics
OTLP_LOGS_ENABLED=true
OTLP_LOGS_ENDPOINT=http://localhost:14317
LOG_EXPORT_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-grafana-password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
APP_KAFKA_TOPIC_PARTITIONS=3
APP_KAFKA_TOPIC_REPLICAS=1

# PostgreSQL and service owned databases
POSTGRES_ROOT_USER=syncturtle_root
POSTGRES_ROOT_PASSWORD=local-dev-postgres-root-password
INSTANCE_DB_PASSWORD=local-dev-instance-app-password
INSTANCE_MIGRATOR_DB_PASSWORD=local-dev-instance-migrator-password
USER_DB_PASSWORD=local-dev-user-app-password
USER_MIGRATOR_DB_PASSWORD=local-dev-user-migrator-password
WORKSPACE_DB_PASSWORD=local-dev-workspace-app-password
WORKSPACE_MIGRATOR_DB_PASSWORD=local-dev-workspace-migrator-password
FILE_DB_PASSWORD=local-dev-file-app-password
FILE_MIGRATOR_DB_PASSWORD=local-dev-file-migrator-password
EMAIL_DB_PASSWORD=local-dev-email-app-password
EMAIL_MIGRATOR_DB_PASSWORD=local-dev-email-migrator-password

# Redis
REDIS_PASSWORD=local-dev-redis-password

# file-service and MinIO
MINIO_ROOT_USER=syncturtle_minio
MINIO_ROOT_PASSWORD=local-dev-minio-root-password
APP_STORAGE_ACCESS_KEY=syncturtle_minio
APP_STORAGE_SECRET_KEY=local-dev-minio-application-password
APP_STORAGE_REGION=us-east-1
APP_STORAGE_BUCKET=syncturtle
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_PUBLIC_ENDPOINT=http://localhost
APP_STORAGE_USE_PATH_STYLE=true
APP_STORAGE_PRESIGN_EXPIRATION=1h

# instance-service
APP_NAME=syncturtle
APP_EDITION=COMMUNITY
APP_TEST=false
APP_SKIP_ENV_VAR=true
APP_TELEMETRY_ENABLED=true
APP_TELEMETRY_SUPPORT_REQUIRED=false
APP_ENABLE_SIGNUP=1
APP_ENABLE_EMAIL_PASSWORD=1
APP_DISABLE_WORKSPACE_CREATION=0
APP_ENABLE_SMTP=0
APP_EMAIL_HOST=
APP_EMAIL_HOST_USER=
APP_EMAIL_HOST_PASSWORD=
APP_EMAIL_PORT=587
APP_EMAIL_FROM=
APP_EMAIL_USE_TLS=1
APP_EMAIL_USE_SSL=0
APP_ENABLE_MAGIC_LINK_LOGIN=0
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GITHUB_CLIENT_ID=
APP_GITHUB_CLIENT_SECRET=
APP_GITLAB_HOST=
APP_GITLAB_CLIENT_ID=
APP_GITLAB_CLIENT_SECRET=
APP_INTERCOM_APP_ID=
APP_POSTHOG_API_KEY=
APP_POSTHOG_HOST=

# instance-service product telemetry
PRODUCT_TELEMETRY_ENABLED=false
PRODUCT_TELEMETRY_ENDPOINT=http://localhost:15317
PRODUCT_TELEMETRY_API_KEY=
PRODUCT_TELEMETRY_INTERVAL=10m

# user-service
APP_AUTH_ACCESS_TOKEN_TTL=30m
APP_AUTH_REFRESH_TOKEN_TTL=30d
APP_AUTH_PASSWORD_RESET_TOKEN_TTL=30m
APP_AUTH_PASSWORD_RESET_TOKEN_BYTES=48
APP_AUTH_RUNTIME_CACHE_TTL=1m
APP_AUTH_RUNTIME_SECRET_CACHE_TTL=5m

# workspace-service
APP_WORKSPACE_RUNTIME_CACHE_TTL=1m

# email-service
INSTANCE_SERVICE_BASE_URL=http://localhost:8001
APP_EMAIL_RUNTIME_CONFIG_CACHE_TTL=2m
