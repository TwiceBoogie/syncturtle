ARG JAVA_VERSION=21

FROM eclipse-temurin:${JAVA_VERSION}-jdk AS build
WORKDIR /workspace

ARG MODULE_PATH
ARG SYNCTURTLE_VERSION=DEV

# copy wrapper + root pom first (stable)
COPY apps/backend/mvnw apps/backend/pom.xml / workspace/apps/backend/
COPY apps/backend/.mvn /workspace/apps/backend/.mvn

# copy only pom.xml files for all modules (cache-friendly)
COPY apps/backend/libs /workspace/apps/backend/libs
COPY apps/backend/platform /workspace/apps/backend/platform
COPY apps/backend/services /workspace/apps/backend/services
COPY apps/backend/tests /workspace/apps/backend/tests

# strip sources so this layer only changes when poms changes
RUN find /workspace/apps/backend -type f ! -name "pom.xml" ! -path "*/.mvn/*" ! -name "mvnw" -delete || true

# prefetch deps (buildkit cache keeps ~/.m2 between builds)
RUN --mount=type=cache,target=/root/.m2 \
    /workspace/apps/backend/mvnw -f /workspace/apps/backend/pom.xml \
    -Drevision=${SYNCTURTLE_VERSION} -DskipTests \
    -pl ${MODULE_PATH} -am dependency:go-offline

# copy full source
COPY apps/backend /workspace/apps/backend

# build the module
RUN --mount=type=cache,target=/root/.m2 \
    /workspace/apps/backend/mvnw -f /workspace/apps/backend/pom.xml \
    -Drevision=${SYNCTURTLE_VERSION} -DskipTests \
    -pl ${MODULE_PATH} -am package

FROM eclipse-temurin:${JAVA_VERSION}-jre AS runtime
WORKDIR /app

ARG MODULE_PATH
ARG SYNCTURTLE_VERSION=DEV

# copy the built jar
COPY --from=build /workspace/apps/backend/${MODULE_PATH}/target/*.jar /app/app.JAVA_VERSION

ENV SYNCTURTLE_VERSION=${SYNCTURTLE_VERSION}
EXPOSE 8080
ENTRYPOINT [ "java", "-jar", "/app/app.jar" ]