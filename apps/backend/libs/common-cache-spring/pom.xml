<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.syncturtle</groupId>
    <artifactId>syncturtle-backend</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>common-cache-spring</artifactId>
  <packaging>jar</packaging>
  <name>common-cache-spring</name>

  <dependencies>
    <!-- INTERNAL LIBRARIES -->
    <dependency>
      <groupId>com.syncturtle</groupId>
      <artifactId>common-core</artifactId>
    </dependency>

    <dependency>
      <groupId>com.syncturtle</groupId>
      <artifactId>common-web</artifactId>
    </dependency>

    <!-- AUTO-CONFIGURATION INFRASTRUCTURE -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- SPRING BOOT 4 REDIS MODULE -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-redis</artifactId>
    </dependency>

    <!-- SPRING BOOT 4 JACKSON 3 MODULE -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson</artifactId>
    </dependency>

    <!-- SPRING WEB TYPES -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>

    <!-- AOP -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
    </dependency>

    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>

    <!-- SERVLET API -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- TESTS -->
    <dependency>
      <groupId>com.syncturtle</groupId>
      <artifactId>test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>