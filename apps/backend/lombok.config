config.stopBubbling = true

# Jackson 3 databind still uses Jackson 2's com.fasterxml.jackson.annotation types.
# Builders must use tools.jackson.databind annotations, not Jackson 2 databind.
# JDT LS can intermittently ignore this file: https://github.com/projectlombok/lombok/issues/4058
clear lombok.jacksonized.jacksonVersion
lombok.jacksonized.jacksonVersion += 3
