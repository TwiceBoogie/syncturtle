{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path out/_pagefind",
    "build:dist": "yarn build && rm -rf dist && mv out dist",
    "start": "npx serve out",
    "start:dist": "npx serve dist",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.0.0-beta.5",
    "@heroui/styles": "^3.0.0-beta.5",
    "@syncturtle/utils": "workspace:*",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@syncturtle/eslint-config": "workspace:*",
    "@syncturtle/tailwind-config": "workspace:*",
    "@syncturtle/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
